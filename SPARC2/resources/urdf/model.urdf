<?xml version="1.0" ?>
<robot name="drt_workcell" version="1.0">
  <!-- 글로벌 기준 프레임 (World Reference Frame) -->
  <link name="world"/>

  <!-- ============================================================
       글로벌 원점 조인트 (Global Origin Joint)
       - 아래 <origin xyz="0" rpy="0"/> 의 좌표(xyz) 및 회전(rpy)을 수정하면
         전체 로봇 워크셀(3개 파트 모두)이 글로벌 원점(world)을 기준으로 이동 및 회전합니다.
       ============================================================ -->
  <joint name="global_origin" type="fixed">
    <parent link="world"/>
    <child link="global_virtual_link"/>
    <origin xyz="3.28 1.5 0" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       로봇 워크셀 기저 (Robot Workcell Base Link)
       - 하나의 기저(global_virtual_link)에서 3개의 독립 파트로 분기됩니다:
         1) 파트 1 (RT 시스템):       joint_20_rail_RT -> r1_linear_base ...
         2) 파트 2 (DDA 시스템):      joint_21_rail_DDA -> r2_linear_base ...
         3) 파트 3 (포지셔너 시스템): joint_22_positioner_base -> link_22_positioner_base ...
       ============================================================ -->
  <link name="global_virtual_link"/>
